{
  "name": "traktivity",
  "version": "3.0.1",
  "description": "Log your activity on Trakt.tv",
  "main": "traktivity.php",
  "files": [
    "build",
    "widgets",
    "admin.traktivity.php",
    "content.traktivity.php",
    "core.traktivity.php",
    "cpt.traktivity.php",
    "rest.traktivity.php",
    "stats.traktivity.php",
    "traktivity.php",
    "uninstall.php",
    "readme.txt"
  ],
  "scripts": {
    "build": "wp-scripts build",
    "plugin-zip": "npm run build && wp-scripts plugin-zip && zip -q -d traktivity.zip traktivity/package.json traktivity/README.md",
    "start": "wp-scripts start",
    "format": "wp-scripts format",
    "lint:js": "wp-scripts lint-js",
    "lint:js:fix": "wp-scripts lint-js --fix",
    "lint:css": "wp-scripts lint-style",
    "lint:css:fix": "wp-scripts lint-style --fix",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules wp-scripts test-unit-js",
    "test:php:db": "wp-env --config=.wp-env.tests.json run cli wp db query \"CREATE DATABASE IF NOT EXISTS traktivity_phpunit\"",
    "test:php": "npm run test:php:db && wp-env --config=.wp-env.tests.json run cli --env-cwd=wp-content/plugins/traktivity vendor/bin/phpunit",
    "test:e2e": "wp-scripts test-playwright",
    "test:package": "npm run plugin-zip && node tests/package/verify-package.mjs",
    "env": "wp-env",
    "env:tests": "wp-env --config=.wp-env.tests.json",
    "packages-update": "wp-scripts packages-update"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeherve/traktivity.git"
  },
  "keywords": [
    "wordpress",
    "plugin",
    "trakt.tv",
    "TMDb",
    "log"
  ],
  "author": "Jeremy Herve",
  "license": "GPL-2.0+",
  "bugs": {
    "url": "https://github.com/jeherve/traktivity/issues"
  },
  "homepage": "https://wordpress.org/plugins/traktivity/",
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@wordpress/api-fetch": "^7.54.0",
    "@wordpress/components": "^40.0.0",
    "@wordpress/e2e-test-utils-playwright": "^1.54.0",
    "@wordpress/element": "^8.6.0",
    "@wordpress/env": "^11.14.0",
    "@wordpress/i18n": "^6.27.0",
    "@wordpress/jest-console": "^9.2.0",
    "@wordpress/scripts": "^34.2.0"
  }
}
